{
  "name": "@railgun-reloaded/prover",
  "version": "1.0.0",
  "description": "Snarkjs Prover for Railgun transactions circuit and POI circuits",
  "homepage": "https://github.com/railgun-reloaded/prover#readme",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/prover/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/railgun-reloaded/prover.git"
  },
  "license": "MIT",
  "author": "RAILGUN Project Contributors",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.ts",
  "scripts": {
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps test/*.test.js test/**/*.test.js",
    "test:adapter": "npm run build && node --test --enable-source-maps test/adapter/**/*.test.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev",
    "snarkjs": "^0.7.5"
  }
}
