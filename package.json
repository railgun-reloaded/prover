{
  "name": "@railgun-reloaded/prover",
  "version": "1.0.0",
  "description": "Snarkjs Prover for Railgun transactions circuit and POI circuits",
  "homepage": "https://github.com/railgun-reloaded/prover#readme",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/prover/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/railgun-reloaded/prover.git"
  },
  "license": "MIT",
  "author": "RAILGUN Project Contributors",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "scripts": {
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=--enable-source-maps brittle --coverage test/**/*.js",
    "test:adapter": "npm run build && NODE_OPTIONS=--enable-source-maps brittle test/adapter/**/*.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@types/node": "^22.13.10",
    "brittle": "^3.12.2",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "snarkjs": "^0.7.5"
  }
}
